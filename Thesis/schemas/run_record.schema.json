{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sheath/run_record.schema.json",
  "title": "Sheath Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "condition",
    "system",
    "budget",
    "events",
    "executables",
    "actions",
    "authorizations",
    "observations",
    "attempt_contexts",
    "proposals",
    "evidence",
    "findings",
    "decision",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.7.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": ["string", "null"]},
    "condition": {"enum": ["direct", "instruction", "self_reflection", "sheath_stage0", "sheath_learned"]},
    "seed": {"type": ["integer", "null"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "runner_revision", "environment_digest", "policy_digest"],
      "properties": {
        "generator_id": {"type": "string", "minLength": 1},
        "supervisor_id": {"type": ["string", "null"]},
        "runner_revision": {"type": "string", "minLength": 1},
        "environment_digest": {"type": "string", "minLength": 1},
        "policy_digest": {"type": "string", "minLength": 1},
        "prompt_digest": {"type": ["string", "null"]},
        "instruction_digest": {"type": ["string", "null"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "max_wall_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_cost": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    },
    "executables": {
      "type": "array",
      "items": {"$ref": "#/$defs/executable"}
    },
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "authorizations": {
      "type": "array",
      "items": {"$ref": "#/$defs/authorization"}
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "attempt_contexts": {
      "type": "array",
      "items": {"$ref": "#/$defs/attempt_context"}
    },
    "proposals": {
      "type": "array",
      "items": {"$ref": "#/$defs/proposal"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reason_codes", "evidence_ids"],
      "properties": {
        "verdict": {"enum": ["accept", "revise", "block", "escalate", "failed"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": ["string", "null"]}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["verified_success", "attempts", "wall_seconds"],
      "properties": {
        "verified_success": {"type": ["boolean", "null"]},
        "attempts": {"type": "integer", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0},
        "tokens": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "protocol_deviations": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "kind", "timestamp"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["proposal", "tool_request", "tool_observation", "patch", "assessment", "feedback", "override", "error", "evidence", "state_transition"]},
        "timestamp": {"type": "string", "format": "date-time"},
        "content_artifact_id": {"type": ["string", "null"]},
        "proposal_id": {"type": ["string", "null"]},
        "evidence_id": {"type": ["string", "null"]},
        "action_id": {"type": ["string", "null"]},
        "authorization_id": {"type": ["string", "null"]},
        "observation_id": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "from_state": {"type": ["string", "null"]},
        "to_state": {"type": ["string", "null"]},
        "exit_code": {"type": ["integer", "null"]},
        "status": {"type": ["string", "null"]}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "working_directory", "timeout_seconds", "max_output_bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "working_directory": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_output_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "digest", "size_bytes", "scope", "image_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "scope": {"enum": ["host_file", "container_image"]},
        "image_digest": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "host_file"}}},
          "then": {
            "properties": {
              "size_bytes": {"minimum": 1},
              "image_digest": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"scope": {"const": "container_image"}}},
          "then": {
            "properties": {
              "size_bytes": {"const": 0},
              "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action_id", "revision", "allowed", "reason_codes", "resolved_working_directory", "executable_id", "policy_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "allowed": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "resolved_working_directory": {"type": ["string", "null"]},
        "executable_id": {"type": ["string", "null"]},
        "policy_digest": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action_id", "revision", "started_at", "ended_at", "exit_code", "timed_out", "stdout_digest", "stderr_digest", "stdout_artifact_id", "stderr_artifact_id", "environment_digest", "sandbox_id", "sandbox_version", "sandbox_digest", "sandbox_guarantees", "stdout_truncated", "stderr_truncated"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "stdout_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "stderr_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "stdout_artifact_id": {"type": "string", "minLength": 1},
        "stderr_artifact_id": {"type": "string", "minLength": 1},
        "environment_digest": {"type": "string", "minLength": 1},
        "sandbox_id": {"type": "string", "minLength": 1},
        "sandbox_version": {"type": "string", "minLength": 1},
        "sandbox_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sandbox_guarantees": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["filesystem_isolated", "network_disabled", "process_isolated", "resource_limits_enforced", "executable_identity_enforced"]
          }
        },
        "stdout_truncated": {"type": "boolean"},
        "stderr_truncated": {"type": "boolean"}
      }
    },
    "attempt_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "proposal_id", "revision", "policy_digest", "environment_digests", "action_ids", "authorization_ids", "observation_ids"],
      "properties": {
        "attempt": {"type": ["integer", "null"], "minimum": 1},
        "proposal_id": {"type": ["string", "null"], "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "policy_digest": {"type": ["string", "null"], "minLength": 1},
        "environment_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "action_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authorization_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generator_id", "revision", "source_digest", "result_digest", "attempt", "feedback", "response_artifact_id", "patch_artifact_id", "claims", "changed_paths"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "generator_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "attempt": {"type": "integer", "minimum": 1},
        "feedback": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "response_artifact_id": {"type": "string", "minLength": 1},
        "patch_artifact_id": {"type": "string", "minLength": 1},
        "claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "changed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\.$)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check_id", "revision", "passed", "source", "recorded_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "check_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "source": {"enum": ["policy", "tool", "rule", "critic", "human"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "detail": {"type": "string"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "evidence_ids", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["supported", "unsupported", "contradicted", "unknown"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "severity", "message", "evidence_ids", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["epistemic_gap", "constraint_violation", "scope_violation", "evidence_gap", "impact_gap", "unsafe_action", "engineering_defect", "no_violation", "other"]},
        "severity": {"enum": ["info", "warning", "revision", "blocking", "escalation"]},
        "message": {"type": "string", "minLength": 1},
        "constraint_id": {"type": ["string", "null"]},
        "location": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "source": {"enum": ["policy", "tool", "rule", "critic", "human"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "digest", "size_bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["prompt", "response", "patch", "stdout", "stderr", "test_report", "analysis_report", "manifest", "other"]},
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "redacted": {"type": "boolean", "default": false}
      }
    }
  }
}
