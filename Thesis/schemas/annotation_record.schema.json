{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sheath/annotation_record.schema.json",
  "title": "Sheath Pilot Annotation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "guide_version", "annotations", "adjudication"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "guide_version": {"type": "string", "minLength": 1},
    "annotations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/annotation"}
    },
    "adjudication": {"$ref": "#/$defs/adjudication"}
  },
  "$defs": {
    "action": {"enum": ["accept", "revise", "block", "escalate"]},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observation",
        "artifact_refs",
        "contract_refs",
        "category",
        "severity",
        "refuting_evidence",
        "recommended_action"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "contract_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "category": {
          "enum": [
            "epistemic_gap",
            "constraint_violation",
            "scope_violation",
            "evidence_gap",
            "impact_gap",
            "unsafe_action",
            "engineering_defect"
          ]
        },
        "severity": {"enum": ["info", "warning", "revision", "blocking", "escalation"]},
        "refuting_evidence": {"type": "string", "minLength": 1},
        "recommended_action": {"$ref": "#/$defs/action"}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "reviewer_id",
        "recorded_at",
        "no_violation",
        "findings",
        "case_action"
      ],
      "properties": {
        "annotation_id": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "no_violation": {"type": "boolean"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "case_action": {"$ref": "#/$defs/action"}
      },
      "allOf": [
        {
          "if": {"properties": {"no_violation": {"const": true}}},
          "then": {
            "properties": {
              "findings": {"type": "array", "maxItems": 0},
              "case_action": {"const": "accept"}
            }
          },
          "else": {"properties": {"findings": {"type": "array", "minItems": 1}}}
        }
      ]
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "recorded_at",
        "source_annotation_ids",
        "no_violation",
        "findings",
        "case_action",
        "rationale"
      ],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "source_annotation_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "no_violation": {"type": "boolean"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "case_action": {"$ref": "#/$defs/action"},
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"no_violation": {"const": true}}},
          "then": {
            "properties": {
              "findings": {"type": "array", "maxItems": 0},
              "case_action": {"const": "accept"}
            }
          },
          "else": {"properties": {"findings": {"type": "array", "minItems": 1}}}
        }
      ]
    }
  }
}
